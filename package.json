{
  "name": "tiny-buddy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @tiny-buddy/server dev",
    "dev:web": "pnpm --filter @tiny-buddy/web dev",
    "build": "pnpm --filter @tiny-buddy/web build",
    "start": "pnpm --filter @tiny-buddy/server start",
    "seed": "pnpm --filter @tiny-buddy/server seed",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
