# ===== 服务 =====
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:8787

# SQLite 文件位置（默认 ./data/tiny-buddy.db）
# DATABASE_FILE=./data/tiny-buddy.db
# JWT_SECRET=请替换为随机字符串（留空会自动生成并持久化到 data/.jwt-secret）

# ===== 模型（OpenAI 兼容）=====
# 留空则使用内置离线演示模型（MockProvider），工具调用链路完全一致
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
LLM_PROVIDER_NAME=DeepSeek

# ===== 注册策略 =====
# 生产环境设为 false 可关闭自助注册
ALLOW_REGISTER=true
